---
import Base from '../layouts/Base.astro';
import HomeSystem from '../components/HomeSystem.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import HomeCredentials from '../components/HomeCredentials.astro';
import {site,projects,journey} from '../data/site';
import '../styles/home.css';
const layers=[0,0,1,2,1,2,1,1];
const ordered=[projects[0],projects[1],projects[5],projects[2],projects[3],projects[4],projects[6],projects[7]];
---
<Base>
  <section class="hero home-hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="role-label"><span class="status-dot" aria-hidden="true"></span>AI systems & inference engineer</p>
      <h1 id="hero-title">Usama <br/>Aslam<span>.</span></h1>
      <p class="hero-statement">I build AI that connects<br/>to the real world.</p>
      <p class="hero-intro">Agents, Urdu speech, and the infrastructure underneath. I bring the layers together to make AI useful.</p>
      <div class="hero-actions"><a class="button primary" href="#work"><span>Explore my work</span><span aria-hidden="true">↘</span></a><a class="hero-about-link" href="#about">Meet the engineer <span aria-hidden="true">↗</span></a></div>
    </div>
    <HomeSystem/>
    <div class="hero-foot"><span>Currently building AI at <strong>Nayatel</strong></span><span>Electrical engineering <i aria-hidden="true">→</i> Networks <i aria-hidden="true">→</i> Systems <i aria-hidden="true">→</i> AI</span></div>
  </section>
  <section class="home-proof shell" aria-label="Selected work and recognition at a glance">
    <a href="/work/customer-support/"><span class="proof-type">Customer support</span><strong>≈40k<span aria-hidden="true">↗</span></strong><span>support conversations a month</span><small>Owner-confirmed monthly estimate</small></a>
    <a href="/work/urdu-speech/"><span class="proof-type">Ghalib · Urdu speech</span><strong>48 kHz<span aria-hidden="true">↗</span></strong><span>a voice built for Urdu</span><small>Native streaming · four voice styles</small></a>
    <a href="#credentials"><span class="proof-type">Team recognition</span><strong class="proof-award">Best Team<span aria-hidden="true">↗</span></strong><span>Huawei AI Developer Golden Seed program</span><small>Recognition earned with the team</small></a>
  </section>
  <section class="work-section home-work shell" id="work" aria-labelledby="work-title">
    <div class="home-section-heading"><div><p class="section-kicker">Selected work</p><h2 id="work-title">Different layers.<br/>One engineering mindset.</h2></div><p>Customer-facing agents, organization-wide AI tools, and the intelligence behind them. Explore the problems I work on and how the pieces connect.</p></div>
    <div class="filter-bar"><div class="filters" role="group" aria-label="Filter projects">{['All work','Agents','Platforms','Intelligence'].map((c,i)=><button type="button" class="filter" data-filter={i===0?'all':c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div><span class="project-count" aria-live="polite">8 projects</span></div>
    <p class="work-layer-note"><span class="layer-key" aria-hidden="true"></span><strong data-work-layer aria-live="polite">Conversation</strong><span>Follow the copper markers to related work.</span></p>
    <div class="project-grid">{ordered.map((p,i)=><article class:list={['project',{'project-featured':i===0,'project-wide':i===3,'project-index':i>=4}]} data-category={p.category} data-project-layer={layers[i]} data-layer-match={layers[i]===0?true:undefined}>
      {i<4&&<a class="project-cover-link" href={`/work/${p.slug}/`} aria-label={`Read ${p.label} case study`}><div class:list={['project-cover',p.color]}><div class="cover-top"><span>{p.label}</span><span class="cover-corner" aria-hidden="true">↗</span></div><ProjectVisual kind={p.cover}/><div class="cover-bottom"><span>{p.category}</span><span>{i===0?'Verified estimate · monthly volume':p.slug==='urdu-speech'?'My Urdu speech model':'Conceptual project view'}</span></div></div></a>}
      <div class="project-info"><div class="project-meta"><span>{i>=4?`0${i+1} / ${p.category}`:p.category}</span><span>{p.scope.includes('Personal')?'Independent project':p.scope.includes('Nayatel')?'Nayatel':'Engineering project'}</span></div><h3><a href={`/work/${p.slug}/`}>{p.label}</a></h3><p>{p.summary}</p><div class="tags">{p.stack.slice(0,i>=4?3:4).map(s=><span>{s}</span>)}</div><a class="text-link" href={`/work/${p.slug}/`}>Read case study <span aria-hidden="true">↗</span></a></div>
      {i>=4&&<a class="index-project-arrow" href={`/work/${p.slug}/`} aria-label={`Read ${p.label} case study`}><span aria-hidden="true">↗</span></a>}
    </article>)}</div>
  </section>
  <section class="about-section home-about" id="about" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div class="about-heading"><p class="section-kicker">The person behind the systems</p><h2 id="about-title">An engineer.<br/>Across every layer.</h2><figure class="about-portrait"><img src="/images/usama-aslam.webp" srcset="/images/usama-aslam-480.webp 480w, /images/usama-aslam.webp 960w" sizes="(max-width:760px) calc(100vw - 44px), 420px" width="960" height="1200" alt="Muhammad Usama Aslam wearing glasses and a navy suit" loading="lazy" decoding="async"/><figcaption><strong>Muhammad Usama Aslam</strong><span>Electrical engineering to production AI.</span></figcaption></figure></div>
      <div class="about-copy"><p class="large-copy">My route into AI started long before the models.</p><p class="home-about-intro">Electrical engineering, customer troubleshooting, network operations, and systems work taught me to follow a problem through every layer. That is the perspective I bring to AI today.</p>
        <ol class="career-journey" aria-label="Career journey">{journey.map((step,i)=><li class:list={{'journey-current':i===journey.length-1}}><details open={i===journey.length-1}><summary><span class="journey-order">0{i+1}</span><span><strong>{step.stage}</strong><small>{step.lens}</small></span><span class="journey-toggle" aria-hidden="true">+</span></summary><p>{step.text}</p></details></li>)}</ol>
        <div class="journey-together"><h3>How it changes the work</h3><p>I can look at a failed AI interaction from several angles: what the customer needed, what the agent understood, which service it called, and what the network or server did next. That range helps me find the right failure boundary and balance usefulness, reliability, latency, and cost.</p></div>
      </div>
    </div>
  </section>
  <HomeCredentials/>
  <section class="contact-section home-contact shell" id="contact" aria-labelledby="contact-title"><div><p class="section-kicker">Let’s connect</p><h2 id="contact-title">Have a system<br/>worth building<span>?</span></h2></div><div class="contact-copy"><p>Working on agents, inference, or AI infrastructure? I’d like to hear what you’re building.</p><a class="button primary" href={`mailto:${site.email}`}><span>Start a conversation</span><span aria-hidden="true">↗</span></a><a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a><div class="contact-socials"><a class="text-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div></div></section>
</Base>
