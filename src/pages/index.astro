---
import Base from '../layouts/Base.astro';
import Signal from '../components/Signal.astro';
import { site, projects, journey } from '../data/site';
---
<Base>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="role-label"><span class="status-dot" aria-hidden="true"></span> AI systems & inference engineer</p><h1 id="hero-title">I build the<br/>system behind<br/><span class="answer-line">the answer<span class="answer-period">.</span></span></h1><p class="hero-intro">I’m Usama. I connect models, knowledge, and infrastructure to build AI that works in the real world.</p><a class="button primary" href="#work"><span>Explore my work</span><span aria-hidden="true">↘</span></a></div>
    <div class="hero-system"><div class="system-meta"><span>The whole system matters.</span><span class="mini-cross" aria-hidden="true">+</span></div><div class="system-drawing"><Signal /></div><div class="layer-controls" role="group" aria-label="Explore a system layer"><button type="button" data-layer="0" aria-pressed="true">Conversation</button><button type="button" data-layer="1" aria-pressed="false">Intelligence</button><button type="button" data-layer="2" aria-pressed="false">Infrastructure</button></div><p class="layer-description" aria-live="polite">A useful answer starts with understanding the person on the other end.</p><span class="system-caption">Conceptual architecture · select a layer</span></div>
    <div class="hero-foot"><span>Currently building AI at <strong>Nayatel</strong></span><span>From networks to inference.<span class="foot-route" aria-hidden="true"> ───○───●</span></span></div>
  </section>
  <section class="work-section shell" id="work" aria-labelledby="work-title">
    <div class="section-header"><div><p class="section-kicker">Selected work</p><h2 id="work-title">From the first signal<br/>to the final answer.</h2></div><p class="section-intro">Agents, platforms, and intelligence.<br/>Different layers. One engineering mindset.</p></div>
    <div class="filter-bar"><div class="filters" role="group" aria-label="Filter projects">{['All work','Agents','Platforms','Intelligence'].map((c,i)=><button type="button" class="filter" data-filter={i===0?'all':c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div><span class="project-count" aria-live="polite">8 projects</span></div>
    <div class="project-grid">{projects.map((p,i)=><article class:list={['project',{'project-featured':i===0}]} data-category={p.category}><a class="project-cover-link" href={`/work/${p.slug}/`} aria-label={`Read ${p.label} case study`}><div class:list={['project-cover',p.color]}><div class="cover-top"><span>{p.label}</span><span class="cover-corner" aria-hidden="true">↗</span></div><Signal kind={p.cover} compact /><div class="cover-bottom"><span>{p.category}</span><span class="cover-caption">System study</span></div></div></a><div class="project-info"><div class="project-meta"><span>{p.category}</span><span>{p.scope.includes('Personal')?'Independent project':p.scope.includes('Nayatel')?'Nayatel':'Engineering project'}</span></div><h3><a href={`/work/${p.slug}/`}>{p.title}</a></h3><p>{p.summary}</p><div class="tags">{p.stack.slice(0,4).map(s=><span>{s}</span>)}</div><a class="text-link" href={`/work/${p.slug}/`}>Read case study <span aria-hidden="true">↗</span></a></div></article>)}</div>
  </section>
  <section class="about-section" id="about" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div class="about-heading">
        <p class="section-kicker">My journey</p>
        <h2 id="about-title">Every layer<br/>shaped <span>the next.</span></h2>
        <figure class="about-portrait">
          <img src="/images/usama-aslam.webp" srcset="/images/usama-aslam-480.webp 480w, /images/usama-aslam.webp 960w" sizes="(max-width: 760px) calc(100vw - 44px), (max-width: 1100px) 40vw, 420px" width="960" height="1200" alt="Muhammad Usama Aslam wearing glasses and a navy suit" loading="lazy" decoding="async" />
          <figcaption><strong>Muhammad Usama Aslam</strong><span>Electrical engineering to production AI.</span></figcaption>
        </figure>
      </div>
      <div class="about-copy">
        <p class="large-copy">I started as an electrical engineer. TAC, NOC, and Systems led me to the AI systems I build today.</p>
        <ol class="career-journey" aria-label="Career journey">
          {journey.map((step,i)=><li class:list={{'journey-current':i===journey.length-1}}><div class="journey-stage"><h3>{step.stage}</h3>{i===journey.length-1&&<span class="journey-now">Now</span>}</div><p class="journey-lens">{step.lens}</p><p>{step.text}</p></li>)}
        </ol>
        <div class="journey-together"><h3>How it helps me build</h3><p>I can look at a failed AI interaction from several angles: what the customer needed, what the agent understood, which service it called, and what the network or server did next. That range helps me ask better questions, find the right failure boundary, and make decisions that balance usefulness, reliability, latency, and cost.</p></div>
      </div>
    </div>
  </section>
  <section class="contact-section shell" id="contact" aria-labelledby="contact-title"><div><p class="section-kicker">Start a conversation</p><h2 id="contact-title">Let’s build<br/>something useful<span>.</span></h2></div><div class="contact-copy"><p>Working on agents, inference, or AI infrastructure? I’d like to hear what you’re building.</p><a class="button primary" href={`mailto:${site.email}`}><span>Email me</span><span aria-hidden="true">↗</span></a><a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a><div class="contact-socials"><a class="text-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div></div></section>
</Base>
