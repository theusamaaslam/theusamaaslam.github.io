---
import { credentials, furtherLearning, achievements } from '../data/credentials';
import { site } from '../data/site';
---
<section class="credentials-section shell" id="credentials" aria-labelledby="credentials-title">
  <div class="credentials-heading"><div><p class="section-kicker">Learning & recognition</p><h2 id="credentials-title">The work grows.<br/>So do I.</h2></div><p>My path crosses customer operations, infrastructure, and AI. I keep learning across those layers—and learning how to share what I know.</p></div>
  <div class="achievement-list">{achievements.map((item,i)=><article><span class="achievement-number">0{i+1}</span><div><p class="achievement-label">{item.label}</p><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div>
  <a class="text-link" href={`${site.linkedin}recent-activity/all/`} target="_blank" rel="noopener noreferrer">Stories from my journey on LinkedIn <span aria-hidden="true">↗</span></a>
  <div class="certification-heading"><h3>Certifications</h3><p>AI, cloud architecture, agents, and observability.</p></div>
  <div class="credential-list">{credentials.map(c=><a href={c.url} target="_blank" rel="noopener noreferrer"><span class="credential-issuer">{c.issuer}<small>{c.date}</small></span><span class="credential-title">{c.title}</span><span class="credential-arrow" aria-hidden="true">↗</span><span class="sr-only"> — view credential or LinkedIn record</span></a>)}</div>
  <details class="further-learning"><summary>More certifications & training <span aria-hidden="true">+</span></summary><ul>{furtherLearning.map(c=><li><strong>{c.title}</strong><span>{c.issuer} · {c.date}</span></li>)}</ul><a class="text-link" href={`${site.linkedin}details/certifications/`} target="_blank" rel="noopener noreferrer">View all records on LinkedIn <span aria-hidden="true">↗</span></a></details>
</section>
<style>
.credentials-section{padding-block:95px}.credentials-heading{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:end}.credentials-heading h2{font-size:clamp(38px,4.2vw,62px);letter-spacing:-.055em;line-height:1.06}.credentials-heading>p{max-width:480px;font-size:16px;color:var(--muted)}.achievement-list{margin-top:45px}.achievement-list article{display:grid;grid-template-columns:60px 1fr;gap:25px;padding:28px 0;border-bottom:1px solid var(--line)}.achievement-number{font-family:monospace;color:var(--accent);font-size:13px;padding-top:3px}.achievement-label{font-size:11px;color:var(--muted);margin-bottom:10px}.achievement-list h3{font-size:27px;letter-spacing:-.035em}.achievement-list article div>p:last-child{font-size:15px;color:var(--muted);max-width:850px;margin-top:13px}.certification-heading{display:flex;justify-content:space-between;gap:25px;align-items:baseline;margin-top:65px;padding-bottom:25px}.certification-heading h3{font-size:30px;letter-spacing:-.04em}.certification-heading p{font-size:13px;color:var(--muted)}.credential-list{border-top:1px solid var(--line)}.credential-list>a{display:grid;grid-template-columns:190px 1fr 25px;gap:30px;padding:22px 0;border-bottom:1px solid var(--line);align-items:center}.credential-issuer{font-size:13px;font-weight:600}.credential-issuer small{display:block;font-size:11px;color:var(--muted);font-weight:400;margin-top:5px}.credential-title{font-size:16px;max-width:700px}.credential-arrow{color:var(--accent);font-size:20px;transition:translate .3s}.credential-list a:hover .credential-arrow{translate:3px -3px}.further-learning{margin-top:25px}.further-learning summary{display:flex;justify-content:space-between;cursor:pointer;padding:15px 0;font-size:14px;font-weight:600}.further-learning summary:focus-visible{outline:3px solid var(--accent);outline-offset:5px}.further-learning[open] summary>span{rotate:45deg}.further-learning ul{list-style:none;padding:0;margin:10px 0}.further-learning li{padding:15px 0;border-bottom:1px solid var(--line);font-size:14px}.further-learning li strong{font-weight:500}.further-learning li span{display:block;font-size:12px;color:var(--muted);margin-top:7px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:760px){.credentials-section{padding-block:60px}.credentials-heading{grid-template-columns:1fr;gap:24px}.credentials-heading>p{font-size:14px}.achievement-list{margin-top:25px}.achievement-list article{grid-template-columns:25px 1fr;gap:15px}.achievement-list h3{font-size:23px}.achievement-list article div>p:last-child{font-size:14px}.certification-heading{display:block;margin-top:45px}.certification-heading p{margin-top:12px}.credential-list>a{grid-template-columns:1fr 22px;gap:12px;padding:20px 0}.credential-issuer{grid-column:1}.credential-issuer small{display:inline;margin-left:12px}.credential-title{grid-column:1;grid-row:2;font-size:14px}.credential-arrow{grid-column:2;grid-row:1/3}.credential-list a:hover .credential-arrow{translate:none}}
</style>
