---
import { supportFigure } from '../lib/support-map.mjs';
import '../lib/anatomy/iso.css';
const parts = [
  {id:'rag', number:'01', name:'LightRAG', subtitle:'Knowledge → usable context', title:'Good retrieval starts before the question.', text:'We use LightRAG with custom-coded ingestion and retrieval tailored to support queries. Ingestion prepares organizational knowledge; retrieval brings the relevant context into the conversation when a customer asks for help.', detail:'My work with the team connects the knowledge pipeline to the questions customers actually ask.', tags:['Custom ingestion','Query-specific retrieval','Organizational knowledge']},
  {id:'mcp', number:'02', name:'Central MCP', subtitle:'Legacy systems → agent tools', title:'Make existing systems usable by the agent.', text:'Our central Model Context Protocol (MCP) server connects legacy customer systems to the chatbot. The agent can check live customer information and use troubleshooting tools to investigate complex issues rather than relying on knowledge-base text alone.', detail:'Knowledge explains the service. MCP tools help the assistant check what is happening for this customer.', tags:['Legacy integrations','Customer checks','Troubleshooting tools']},
  {id:'chat', number:'03', name:'Chatbot', subtitle:'Customer message → next action', title:'Bring knowledge and action into one conversation.', text:'The support chatbot connects through DSM and coordinates the WhatsApp conversation, retrieves useful knowledge, and calls connected tools when the customer’s issue needs a live check. It guides troubleshooting and passes the conversation to a human when further support is needed.', detail:'This is the customer-facing layer of a system my team and I built together.', tags:['WhatsApp','Guided troubleshooting','Tool orchestration','Human handover']},
  {id:'dsm', number:'04', name:'DSM dashboard', subtitle:'AI assistance → human operations', title:'Keep the support team in the same loop.', text:'WhatsApp connects to DSM, our central agent dashboard for conversation routing, reporting, and human support. Agents work from shared conversation context, with department queues, assignment, and handover connecting automation to the people who continue the work.', detail:'The dashboard makes the service operable: people can see activity, take ownership, and continue helping.', tags:['Human-agent workspace','Reports','Queues & assignment','Conversation context']},
];
---
<section class="support-explorer" aria-labelledby="architecture-title" data-support-explorer>
  <div class="explorer-intro"><p class="section-kicker">Inside the project</p><h2 id="architecture-title">Four components.<br/>One support workflow.</h2><p>I co-developed this platform with my team, including custom ingestion and retrieval for LightRAG and a central MCP connection to legacy customer systems. Explore how knowledge, tools, conversations, and human support work together.</p></div>
  <figure class="support-figure">
    <div class="support-plate">
      <div class="plate-heading"><span>Connected support infrastructure</span><span>Select a component to explore</span></div>
      <Fragment set:html={supportFigure()}/>
      <Fragment set:html={supportFigure({mobile:true})}/>
      <div class="plate-heading plate-bottom"><span>Knowledge · tools · people</span><span data-machine-readout>03 / Chatbot</span></div>
    </div>
    <figcaption>WhatsApp connects to DSM, which brings AI conversations and human agents into one workspace. The chatbot uses LightRAG for knowledge and the central MCP server for live customer checks and troubleshooting. The modules illustrate software responsibilities, not company hardware.</figcaption>
  </figure>
  <div class="component-controls" role="group" aria-label="Explore support components">{parts.map((part,i)=><button type="button" data-component={part.id} aria-pressed={i===0?'true':'false'} aria-controls={`support-${part.id}`}><span>{part.number}</span>{part.name}<small>{part.subtitle}</small></button>)}</div>
  <div class="component-details">{parts.map(part=><section id={`support-${part.id}`} data-component-detail={part.id} class="component-detail"><p class="component-index">{part.number} / {part.name}</p><div><h3>{part.title}</h3><p>{part.text}</p><p class="detail-note">{part.detail}</p><ul class="component-tags">{part.tags.map(tag=><li>{tag}</li>)}</ul></div></section>)}</div>
  <div class="walkthrough">
    <div><p class="section-kicker">Follow a request</p><h3>See the connections in use.</h3><p>Choose an illustrative workflow, then move through its steps.</p></div>
    <div class="walkthrough-controls"><label for="support-scenario">Example workflow</label><select id="support-scenario"><option value="knowledge">A service question</option><option value="troubleshoot">A complex customer issue</option><option value="handover">A human handover</option></select><div class="walkthrough-actions"><button type="button" data-walk-next>Next step <span aria-hidden="true">→</span></button><button type="button" data-walk-play aria-pressed="false">Play walkthrough</button></div><p class="walk-step" aria-live="polite" data-walk-step>1 / 5 · DSM receives the customer’s WhatsApp message.</p></div>
  </div>
</section>
<style>
.support-explorer{padding-top:55px}.explorer-intro{display:grid;grid-template-columns:1fr 1fr;column-gap:65px;align-items:end}.explorer-intro .section-kicker{grid-column:1/-1}.explorer-intro h2{font-size:clamp(32px,4vw,56px);letter-spacing:-.05em;line-height:1.1}.explorer-intro>p:last-child{font-size:16px;color:var(--muted);max-width:520px}
.support-figure{margin:32px 0 25px}.support-plate{border:1px solid #c9d1c2;border-radius:10px;background:#e8ede2;padding:22px 24px}.plate-heading{display:flex;justify-content:space-between;gap:15px;font-family:monospace;font-size:12px;color:#526056}.plate-bottom{padding-top:10px}.support-figure figcaption{font-size:12px;color:var(--muted);max-width:950px;line-height:1.75;margin-top:14px}.support-figure :global(.support-machine){width:100%;height:auto;margin:18px 0}.support-figure :global(.support-map-mobile){display:none}.support-figure :global(text){font-family:Manrope,Arial,sans-serif;fill:var(--ink)}.support-figure :global(.map-title){font-size:21px;font-weight:650;letter-spacing:-.5px}.support-figure :global(.map-copy){font-size:15px;fill:#526056}.support-figure :global(.map-eyebrow){font-size:10px;letter-spacing:.75px;font-weight:650;fill:#526056}.support-figure :global(.map-small){font-size:12px;fill:#3f5142}.support-figure :global(.map-edge-label){font-size:14px;fill:#3e5141;font-weight:500}.support-figure :global(.node-body){fill:#f5f6f0;stroke:#a9b6a1;stroke-width:1.4}.support-figure :global(.context-body){fill:#edf1e8;stroke:#a9b6a1;stroke-width:1.4;stroke-dasharray:5 4}.support-figure :global(.map-icon path){fill:none;stroke:#526a55;stroke-width:1.7;stroke-linejoin:round;stroke-linecap:round}.support-figure :global(.map-pill){fill:#e4eadb;stroke:#cad5bf;stroke-width:1}.support-figure :global(.support-route){fill:none;stroke:#6f8567;stroke-width:1.7;stroke-linejoin:round}.support-figure :global(.map-arrow){fill:#6f8567}.support-figure :global(.support-pulse){fill:var(--accent);opacity:0}.support-figure :global(.interactive-node){cursor:pointer;outline:none}.support-figure :global(.interactive-node:hover .node-body){stroke:#b73b15;stroke-width:2.2}.support-figure :global(.interactive-node:focus-visible .node-body){stroke:#b73b15;stroke-width:3.5}.support-figure :global([data-active] .node-body){fill:#f4dfd1;stroke:#b73b15;stroke-width:2}.support-figure :global([data-active] .map-icon path){stroke:#a53b18}
.component-controls{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.component-controls button{border:1px solid var(--line);border-radius:6px;background:transparent;padding:17px;text-align:left;font-size:16px;font-weight:600;min-height:105px}.component-controls button>span{display:block;font-family:monospace;font-size:11px;color:var(--muted);margin-bottom:7px}.component-controls small{display:block;font-size:11px;font-weight:400;margin-top:8px;color:var(--muted)}.component-controls button[aria-pressed=true]{background:var(--ink);color:var(--ground);border-color:var(--ink)}.component-controls button[aria-pressed=true] :is(span,small){color:#d9e2d3}.component-detail{display:grid;grid-template-columns:1fr 2fr;gap:35px;padding:30px 0;border-bottom:1px solid var(--line)}.component-index{font-family:monospace;font-size:12px;color:var(--accent)}.component-detail h3{font-size:27px;letter-spacing:-.035em;margin-bottom:13px}.component-detail p:not(.component-index){font-size:16px;color:var(--muted);max-width:800px}.component-detail .detail-note{margin-top:13px;font-size:14px!important}.component-tags{list-style:none;display:flex;flex-wrap:wrap;gap:7px;padding:0;margin:20px 0 0}.component-tags li{font-size:11px;border:1px solid var(--line);border-radius:4px;padding:6px 9px}.walkthrough{display:grid;grid-template-columns:1fr 1fr;gap:60px;padding:30px;border:1px solid var(--line);border-radius:8px;margin-top:32px}.walkthrough h3{font-size:25px;letter-spacing:-.035em}.walkthrough p{font-size:14px;color:var(--muted);margin-top:12px}.walkthrough .section-kicker{margin-top:0}.walkthrough-controls label{display:block;font-size:12px;margin-bottom:8px}.walkthrough-controls select{font:inherit;font-size:14px;width:100%;border:1px solid #9fac98;border-radius:4px;background:var(--ground);padding:12px;color:var(--ink)}.walkthrough-actions{display:flex;gap:10px;margin-top:12px}.walkthrough-actions button{border:1px solid var(--ink);background:var(--ink);color:var(--ground);border-radius:4px;padding:12px 15px;font-size:12px}.walkthrough-actions button+button{background:transparent;color:var(--ink)}.walk-step{min-height:48px}.walkthrough-controls select:focus-visible{outline:3px solid var(--accent);outline-offset:3px}

.component-controls button{transition:translate .25s var(--ease),border-color .25s}.walkthrough-actions button{transition:translate .25s}.walkthrough-actions button span{display:inline-block;transition:translate .25s}
@media(hover:hover){.component-controls button:hover{translate:0 -3px;border-color:var(--accent)}.walkthrough-actions button:hover{translate:0 -2px}.walkthrough-actions button:hover span{translate:3px 0}}
@media(max-width:760px){.support-explorer{padding-top:40px}.explorer-intro{grid-template-columns:1fr;gap:20px}.explorer-intro .section-kicker{margin:0}.explorer-intro>p:last-child{font-size:14px}.support-plate{padding:16px 9px}.plate-heading{font-size:9px;gap:10px}.support-figure :global(.support-map-desktop){display:none}.support-figure :global(.support-map-mobile){display:block;margin-block:12px}.support-figure :global(.map-copy){font-size:16px}.support-figure :global(.map-title){font-size:21px}.support-figure :global(.map-eyebrow){font-size:9px;letter-spacing:.3px}.support-figure :global(.map-edge-label){font-size:14px}.support-figure :global(.map-small){font-size:13px}.component-controls{grid-template-columns:1fr 1fr;gap:8px}.component-controls button{font-size:14px;padding:13px;min-height:99px}.component-controls small{font-size:10px}.component-detail{grid-template-columns:1fr;gap:16px;padding:25px 0}.component-detail h3{font-size:23px}.component-detail p:not(.component-index){font-size:14px}.walkthrough{grid-template-columns:1fr;gap:24px;padding:22px}.walkthrough h3{font-size:23px}.walkthrough-actions{flex-wrap:wrap}.support-figure figcaption{font-size:11px}}

.support-plate{background:#e7ecdf;border-color:#c9d1c2;background-image:radial-gradient(#52605612 .8px,transparent .8px);background-size:19px 19px}.plate-heading{color:#526056}.support-figure :global(text){fill:#202922}.support-figure :global(.map-title),.support-figure :global(.map-eyebrow),.support-figure :global(.map-copy){text-anchor:middle}.support-figure :global(.map-title){font-size:21px;font-weight:650;letter-spacing:-.5px}.support-figure :global(.map-eyebrow){font-size:9px;letter-spacing:.7px;fill:#526056}.support-figure :global(.map-copy){font-size:13px;fill:#526056}.support-figure :global(.map-edge-label){font-size:13px;fill:#526056}.support-figure :global(.map-flow-note){font-size:12px;fill:#526056;text-anchor:middle}.support-figure :global(.node-body){fill:transparent;stroke:transparent}.support-figure :global([data-active] .node-body){fill:#b73b1506;stroke:#b73b1555;stroke-dasharray:3 5;stroke-width:1}.support-figure :global(.interactive-node:hover .node-body),.support-figure :global(.interactive-node:focus-visible .node-body){fill:#b73b150a;stroke:#b73b15;stroke-dasharray:none;stroke-width:1.5}.support-figure :global(.support-route){stroke:#829773;stroke-width:1.25}.support-figure :global(.map-arrow){fill:#829773}.support-figure :global(.support-pulse){fill:#b73b15;filter:none}
.support-figure :global(.iso){--anatomy-paper:#dce3d2;--anatomy-top:#eef1e7;--anatomy-shade-0:#b0bda5;--anatomy-shade-1:#c1cdb7;--anatomy-shade-2:#d4ddca;--anatomy-shade-3:#e4e9da;--anatomy-hi:#526056;--anatomy-mid:#829478;--anatomy-lo:#a6b59a;--anatomy-weight:.65px}.support-figure :global(.hw-base .iso-top){fill:#d7dfce}.support-figure :global(.hw-base .iso-shade){fill:#b8c6ad}.support-figure :global(.hw-bay){fill:#26392e;stroke:#8b9d7e;stroke-width:.6}.support-figure :global(.hw-vent){fill:#a9c39b;opacity:.8}.support-figure :global(.hw-led){fill:#b73b15;filter:none}.support-figure :global(.hw-glass){fill:#26392e;stroke:#71876b;stroke-width:.7}.support-figure :global(.hw-sidebar){fill:#40583f}.support-figure :global(.hw-queue){fill:#7a9a73;stroke:#c3d3b7;stroke-width:.4}.support-figure :global(.hw-pin .iso-top){fill:#a7b69b}.support-figure :global(.hw-core .iso-top){fill:#d8b49b}.support-figure :global(.hw-hologram){fill:#dfb69755;stroke:#b17b58;stroke-width:1}.support-figure :global(.hw-message){fill:#9e5b38}.support-figure :global(.hw-chat-in){fill:#809a76;stroke:#b6c7a9;stroke-width:.5}.support-figure :global(.hw-chat-out){fill:#b78362;stroke:#a56138;stroke-width:.5}.support-figure :global(.hw-beam){fill:none;stroke:#b73b15;stroke-width:1;stroke-dasharray:2 3}.support-figure :global(.hw-graph-link){fill:none;stroke:#7b8f74;stroke-width:1}.support-figure :global([data-active] .hw-led){fill:#b73b15}.support-figure :global([data-active] .iso-edge){stroke:#9b4425}
@media(max-width:760px){.plate-heading{font-size:8px}.support-figure :global(.map-copy){font-size:13px}.support-figure :global(.map-title){font-size:20px}.support-figure :global(.map-eyebrow){font-size:8px;letter-spacing:.2px}.support-figure :global(.map-edge-label){font-size:11px}.support-figure :global(.map-flow-note){font-size:10px}}
</style>
