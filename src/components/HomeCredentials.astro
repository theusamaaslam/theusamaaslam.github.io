---
import {credentials,furtherLearning,achievements} from '../data/credentials';
import {site} from '../data/site';
const featured=[credentials[0],credentials[3],credentials[6]];
---
<section class="home-credentials shell" id="credentials" aria-labelledby="credentials-title">
  <div class="home-section-heading"><div><p class="section-kicker">Learning & recognition</p><h2 id="credentials-title">Learning,<br/>put to work.</h2></div><p>Building across disciplines means staying curious. These are a few milestones and the learning behind the work.</p></div>
  <div class="achievement-list">{achievements.map((a,i)=><article><span class="achievement-number">0{i+1}</span><p class="achievement-label">{a.label}</p><h3>{a.title}</h3><p>{a.text}</p></article>)}</div>
  <a class="text-link" href={`${site.linkedin}recent-activity/all/`} target="_blank" rel="noopener noreferrer">More from my journey on LinkedIn <span aria-hidden="true">↗</span></a>
  <div class="home-certification-heading"><h3>Continuing the craft.</h3><span>AI · cloud · agents · observability</span></div>
  <div class="featured-credentials">{featured.map(c=><a href={c.url} target="_blank" rel="noopener noreferrer"><span>{c.issuer}<span aria-hidden="true">↗</span></span><h4>{c.title}</h4><small>{c.date}</small></a>)}</div>
  <details class="all-credentials"><summary>All certifications <span>9 records <i aria-hidden="true">+</i></span></summary><div class="credential-list">{credentials.map(c=><a href={c.url} target="_blank" rel="noopener noreferrer"><span class="credential-issuer">{c.issuer}<small>{c.date}</small></span><span class="credential-title">{c.title}</span><span aria-hidden="true">↗</span></a>)}</div></details>
  <details class="further-learning"><summary>More certifications & training <span>5 records <i aria-hidden="true">+</i></span></summary><ul>{furtherLearning.map(c=><li><strong>{c.title}</strong><span>{c.issuer} · {c.date}</span></li>)}</ul><a class="text-link" href={`${site.linkedin}details/certifications/`} target="_blank" rel="noopener noreferrer">View the complete LinkedIn record <span aria-hidden="true">↗</span></a></details>
</section>
